# Plantilla de variables de entorno del backend.
# Cópiala como backend/.env y completa los valores. backend/.env no se sube a git.

# Clave secreta de Django: única por instalación y nunca compartida.
# Genera una con el comando del README (sección 1).
DJANGO_SECRET_KEY=

# Base de datos PostgreSQL. La contraseña se usa al crear la base por primera
# vez; genera una con el mismo comando que la clave secreta.
DB_NAME=devdb
DB_USER=devuser
DB_PASS=

# Solo para desarrollo: muestra el detalle de los errores. En producción no
# se define (DEBUG queda desactivado).
DJANGO_DEBUG=True

# Dominios desde los que se accede al servidor, separados por comas.
# 10.0.2.2 es la computadora vista desde el emulador de Android.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Origenes en los que Django confia para las peticiones que modifican datos
# (POST, PUT, DELETE), separados por comas. En desarrollo no hace falta: se
# usan los puertos locales de la aplicacion. En produccion, el dominio del
# servidor; si no se define, se toma el de FRONTEND_URL.
# CSRF_TRUSTED_ORIGINS=https://lablend.example.edu
