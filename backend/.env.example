# Plantilla de variables de entorno del backend.
# Cópiala como backend/.env y completa los valores. backend/.env no se sube a git.

# Clave secreta de Django: única por instalación y nunca compartida.
# Genera una con el comando del README (sección 1).
DJANGO_SECRET_KEY=

# Base de datos PostgreSQL. La contraseña se usa al crear la base por primera
# vez; genera una con el mismo comando que la clave secreta.
DB_NAME=devdb
DB_USER=devuser
DB_PASS=
